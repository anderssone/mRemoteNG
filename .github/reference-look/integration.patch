+using System;
+using System.Drawing;
+using System.Globalization;
+using System.IO;
+using mRemoteNG.Themes;
+using mRemoteNG.UI.Forms.OptionsPages;
+using NUnit.Framework;
+
+namespace mRemoteNGTests.Themes
+{
+    [TestFixture]
+    public class FluentThemeMetadataTests
+    {
+        private static string ThemePath => Path.Combine(TestContext.CurrentContext.TestDirectory, "Themes", "Catppuccin Mocha.vstheme");
+
+        [Test]
+        public void PaletteLabels_UseJapaneseOnlyForJapaneseUi()
+        {
+            const string key = "Dialog_Foreground";
+            Assert.That(ThemePage.ColorKeyDisplayName(key, CultureInfo.GetCultureInfo("en-US")), Is.EqualTo("Dialog: Foreground"));
+            Assert.That(ThemePage.ColorKeyDisplayName(key, CultureInfo.GetCultureInfo("sv-SE")), Is.EqualTo("Dialog: Foreground"));
+            Assert.That(ThemePage.ColorKeyDisplayName(key, CultureInfo.GetCultureInfo("ja-JP")), Is.EqualTo("ダイアログ: 文字"));
+            Assert.That(ThemePage.ColorKeyDisplayName("Custom_Unknown_Key", CultureInfo.GetCultureInfo("en-US")), Is.EqualTo("Custom_Unknown_Key"));
+        }
+
+        [Test]
+        public void BundledProfile_LoadsFluentStyleAndExactMochaTints()
+        {
+            ThemeInfo theme = ThemeSerializer.LoadFromXmlFile(ThemePath);
+            Assert.That(theme.Name, Is.EqualTo("Catppuccin Mocha"));
+            Assert.That(theme.UseFluentIcons, Is.True);
+            Assert.That(theme.UseComfortableSpacing, Is.True);
+            Assert.That(theme.IconColor.ToArgb(), Is.EqualTo(Color.FromArgb(203, 166, 247).ToArgb()));
+            Assert.That(theme.DisabledIconColor.ToArgb(), Is.EqualTo(Color.FromArgb(108, 112, 134).ToArgb()));
+            Assert.That(theme.ExtendedPalette.getColor("TextBox_Border").ToArgb(), Is.EqualTo(Color.FromArgb(108, 112, 134).ToArgb()));
+        }
+
+        [Test]
+        public void BundledProfile_CaptionAndSelectedTabTextHasReadableContrast()
+        {
+            var colors = ThemeSerializer.LoadFromXmlFile(ThemePath).Theme.ColorPalette;
+            AssertContrast(colors.ToolWindowCaptionActive.Text, colors.ToolWindowCaptionActive.Background);
+            AssertContrast(colors.ToolWindowCaptionInactive.Text, colors.ToolWindowCaptionInactive.Background);
+            AssertContrast(colors.TabSelectedActive.Text, colors.TabSelectedActive.Background);
+            AssertContrast(colors.TabSelectedInactive.Text, colors.TabSelectedInactive.Background);
+        }
+
+        private static void AssertContrast(Color text, Color background)
+        {
+            static double Channel(byte value)
+            {
+                double channel = value / 255d;
+                return channel <= 0.04045 ? channel / 12.92 : Math.Pow((channel + 0.055) / 1.055, 2.4);
+            }
+            static double Light(Color color) => 0.2126 * Channel(color.R) + 0.7152 * Channel(color.G) + 0.0722 * Channel(color.B);
+            double a = Light(text), b = Light(background);
+            Assert.That((Math.Max(a, b) + 0.05) / (Math.Min(a, b) + 0.05), Is.GreaterThanOrEqualTo(4.5));
+        }
+
+        [Test]
+        public void Clone_PreservesStyleAndColors()
+        {
+            ThemeInfo theme = ThemeSerializer.LoadFromXmlFile(ThemePath);
+            ThemeInfo clone = (ThemeInfo)theme.Clone();
+            Assert.That(clone.UseFluentIcons, Is.True);
+            Assert.That(clone.UseComfortableSpacing, Is.True);
+            Assert.That(clone.IconColor, Is.EqualTo(theme.IconColor));
+            Assert.That(clone.DisabledIconColor, Is.EqualTo(theme.DisabledIconColor));
+        }
+
+        [Test]
+        public void PaletteUpdate_RoundTripsIconMetadata()
+        {
+            string folder = Path.Combine(Path.GetTempPath(), "mRemoteNG-fluent-tests", Guid.NewGuid().ToString("N"));
+            Directory.CreateDirectory(folder);
+            try
+            {
+                string path = Path.Combine(folder, "preview.vstheme"); File.Copy(ThemePath, path);
+                ThemeInfo theme = ThemeSerializer.LoadFromXmlFile(path); theme.IconColor = Color.DarkMagenta;
+                ThemeSerializer.UpdateThemeXMLValues(theme);
+                ThemeInfo reloaded = ThemeSerializer.LoadFromXmlFile(path);
+                Assert.That(reloaded.UseFluentIcons, Is.True);
+                Assert.That(reloaded.UseComfortableSpacing, Is.True);
+                Assert.That(reloaded.IconColor.ToArgb(), Is.EqualTo(Color.DarkMagenta.ToArgb()));
+                theme.UseFluentIcons = false; theme.UseComfortableSpacing = false; ThemeSerializer.UpdateThemeXMLValues(theme);
+                Assert.That(ThemeSerializer.LoadFromXmlFile(path).UseFluentIcons, Is.False);
+                Assert.That(ThemeSerializer.LoadFromXmlFile(path).UseComfortableSpacing, Is.False);
+            }
+            finally { Directory.Delete(folder, true); }
+        }
+    }
+}
diff --git a/mRemoteNGTests/Themes/ThemeIconsTests.cs b/mRemoteNGTests/Themes/ThemeIconsTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..3af39497934e25cab2891d5908fbe87ee81f56a5
--- /dev/null
+++ b/mRemoteNGTests/Themes/ThemeIconsTests.cs
@@ -0,0 +1,165 @@
+using System;
+using System.Drawing;
+using System.Threading;
+using System.Windows.Forms;
+using mRemoteNG.Themes;
+using NUnit.Framework;
+using WeifenLuo.WinFormsUI.Docking;
+
+namespace mRemoteNGTests.Themes
+{
+    [TestFixture, Apartment(ApartmentState.STA), NonParallelizable]
+    public class ThemeIconsTests
+    {
+        private ThemeManager _manager;
+        private ThemeInfo _original;
+        private bool _enabled;
+
+        [SetUp]
+        public void SetUp()
+        {
+            _manager = ThemeManager.getInstance();
+            _enabled = _manager.ThemingActive;
+            _manager.ThemingActive = true;
+            _original = _manager.ActiveTheme;
+            _manager.ActiveTheme = MakeTheme();
+            _manager.ThemingActive = true;
+        }
+
+        [TearDown]
+        public void TearDown() { _manager.ActiveTheme = _original; _manager.ThemingActive = _enabled; }
+
+        private static ThemeInfo MakeTheme() => new("Fluent icon test", new VS2015LightTheme(), "",
+            VisualStudioToolStripExtender.VsVersion.Vs2015, new ExtendedColorPalette())
+        {
+            UseFluentIcons = true, IconColor = Color.FromArgb(203, 166, 247),
+            DisabledIconColor = Color.FromArgb(108, 112, 134)
+        };
+
+        private static Color OpaquePixel(Bitmap image)
+        {
+            Color best = Color.Transparent;
+            for (int y = 0; y < image.Height; y++)
+                for (int x = 0; x < image.Width; x++)
+                    if (image.GetPixel(x, y).A > best.A) best = image.GetPixel(x, y);
+            Assert.That(best.A, Is.GreaterThan(127), "Icon must contain a visible glyph.");
+            return Color.FromArgb(best.R, best.G, best.B);
+        }
+
+        private static void AssertTint(Bitmap image, Color expected)
+        {
+            Color actual = OpaquePixel(image);
+            // GDI+ premultiplied-alpha rounding can shift antialiased channels by one.
+            Assert.That(actual.R, Is.EqualTo(expected.R).Within(1));
+            Assert.That(actual.G, Is.EqualTo(expected.G).Within(1));
+            Assert.That(actual.B, Is.EqualTo(expected.B).Within(1));
+        }
+
+        [TestCase(16), TestCase(20), TestCase(24), TestCase(32), TestCase(48)]
+        public void Render_UsesRequestedDpiSizeAndThemeColor(int size)
+        {
+            using Bitmap icon = ThemeIcons.Create("FolderClosed_16x", _manager.ActiveTheme, true, size);
+            Assert.That(icon.Size, Is.EqualTo(new Size(size, size)));
+            AssertTint(icon, _manager.ActiveTheme.IconColor);
+            Assert.That(icon.GetPixel(0, 0).A, Is.Zero);
+        }
+
+        [Test]
+        public void Render_DisabledUsesSeparateTint()
+        {
+            using Bitmap icon = ThemeIcons.Create("Run_16x", _manager.ActiveTheme, false, 32);
+            AssertTint(icon, _manager.ActiveTheme.DisabledIconColor);
+        }
+
+        [Test]
+        public void Render_ClassicThemeAndUnknownResourcesFallBack()
+        {
+            ThemeInfo classic = MakeTheme(); classic.UseFluentIcons = false;
+            Assert.That(ThemeIcons.Create("Run_16x", classic, true, 16), Is.Null);
+            Assert.That(ThemeIcons.Create("UserSuppliedIcon", _manager.ActiveTheme, true, 16), Is.Null);
+        }
+
+        [TestCase(0), TestCase(257)]
+        public void Render_InvalidSizeIsRejected(int size) =>
+            Assert.Throws<ArgumentOutOfRangeException>(() => ThemeIcons.Create("Run_16x", _manager.ActiveTheme, true, size));
+
+        [Test]
+        public void Bind_UpdatesOnThemeAndEnabledChangesAndRestoresStockResource()
+        {
+            using ToolStrip strip = new(); using ToolStripButton item = new(); strip.Items.Add(item);
+            _manager.ThemingActive = false;
+            ThemeIcons.Bind(item, "Run_16x");
+            Bitmap fallback = (Bitmap)item.Image;
+            Bitmap stock = mRemoteNG.Properties.Resources.Run_16x;
+            Assert.That(fallback.Size, Is.EqualTo(stock.Size));
+            for (int y = 0; y < stock.Height; y++)
+                for (int x = 0; x < stock.Width; x++)
+                    Assert.That(fallback.GetPixel(x, y).ToArgb(), Is.EqualTo(stock.GetPixel(x, y).ToArgb()));
+            _manager.ThemingActive = true;
+            AssertTint((Bitmap)item.Image, _manager.ActiveTheme.IconColor);
+            item.Enabled = false;
+            AssertTint((Bitmap)item.Image, _manager.ActiveTheme.DisabledIconColor);
+            item.Enabled = true;
+            ThemeInfo next = MakeTheme(); next.IconColor = Color.DarkBlue; _manager.ActiveTheme = next;
+            AssertTint((Bitmap)item.Image, Color.DarkBlue);
+            _manager.ThemingActive = false;
+            // ResourceManager can deserialize a fresh bitmap on each lookup. The
+            // binding must restore its own original stock image, still usable.
+            Assert.That(item.Image, Is.SameAs(fallback));
+            Assert.That(fallback.Width, Is.EqualTo(stock.Width));
+        }
+
+        [Test]
+        public void Bind_ReplacingOrDisposingBindingDoesNotDisposeStockResource()
+        {
+            using PictureBox picture = new();
+            _manager.ThemingActive = false;
+            ThemeIcons.Bind(picture, "Copy_16x");
+            Image stock = picture.Image;
+            _manager.ThemingActive = true;
+            Image first = picture.Image;
+            ThemeIcons.Bind(picture, "Copy_16x");
+            Assert.That(picture.Image, Is.Not.SameAs(first));
+            Assert.Throws<ArgumentException>(() => { _ = first.Width; });
+            picture.Dispose();
+            Assert.That(stock.Width, Is.GreaterThan(0));
+            Assert.DoesNotThrow(() => _manager.refreshUI());
+        }
+
+        [Test]
+        public void Bind_EachControlOwnsItsImage()
+        {
+            using PictureBox first = new(); using Button second = new();
+            ThemeIcons.Bind(first, "Copy_16x"); ThemeIcons.Bind(second, "Copy_16x");
+            Assert.That(first.Image, Is.Not.SameAs(second.Image));
+            first.Dispose();
+            Assert.That(second.Image.Width, Is.GreaterThan(0));
+        }
+
+        [Test]
+        public void ConnectionTab_CustomIconIsNotReplacedOnThemeChange()
+        {
+            using Form form = new();
+            mRemoteNG.Connection.ConnectionInfo connection = new() { Icon = "MyCustomIcon" };
+            ThemeIcons.BindConnectionTab(form, connection);
+            Icon initial = form.Icon;
+            _manager.ActiveTheme = MakeTheme();
+            Assert.That(form.Icon, Is.SameAs(initial));
+            form.Dispose();
+            Assert.DoesNotThrow(() => _manager.refreshUI());
+        }
+
+        [Test]
+        public void Render_AllMappedUiGlyphsExist()
+        {
+            string[] keys = { "Add_16x", "AddItem_16x", "AddFolder_16x", "FolderClosed_16x", "ASPWebSite_16x",
+                "Run_16x", "Stop_16x", "Search_16x", "Save_16x", "Settings_16x", "Refresh_16x", "Favorite_16x",
+                "Copy_16x", "Close_16x", "DefaultConnection", "Rename_16x", "SortAscending_16x", "SortDescending_16x",
+                "Schema_16x", "Property_16x", "ExtendedProperty_16x", "ViewDownBySchema_16x",
+                "Panel_16x", "InsertPanel_16x", "FullScreen_16x", "F1Help_16x", "UIAboutBox_16x", "RunUpdate_16x", "Console_16x",
+                "Monitor_16x", "Tab_16x", "LogError_16x", "Key_16x", "SQLDatabase_16x", "Lock_16x",
+                "AppearanceEditor_16x", "OptionsPlugins", "DocumentsFolder_16x" };
+            foreach (string key in keys) { using Bitmap icon = ThemeIcons.Create(key, _manager.ActiveTheme, true, 32); Assert.That(icon, Is.Not.Null, key); }
+        }
+    }
+}
diff --git a/mRemoteNGTests/UI/Controls/RdpConnectingPanelTests.cs b/mRemoteNGTests/UI/Controls/RdpConnectingPanelTests.cs
new file mode 100644
index 0000000000000000000000000000000000000000..c067c2b228ce1fc4f02f5e6fc0038f22caf1b25b
--- /dev/null
+++ b/mRemoteNGTests/UI/Controls/RdpConnectingPanelTests.cs
@@ -0,0 +1,162 @@
+using System;
+using System.Drawing;
+using System.Threading;
+using System.Windows.Forms;
+using mRemoteNG.UI.Controls;
+using NUnit.Framework;
+
+namespace mRemoteNGTests.UI.Controls
+{
+    [TestFixture]
+    [Apartment(ApartmentState.STA)]
+    public class RdpConnectingPanelTests
+    {
+        private Form _window;
+        private Panel _host;
+        private Panel _rdpSurface;
+        private RdpConnectingPanel _cover;
+
+        private sealed class TestWindow : Form
+        {
+            protected override bool ShowWithoutActivation { get { return true; } }
+        }
+
+        [SetUp]
+        public void SetUp()
+        {
+            _window = new TestWindow
+            {
+                ShowInTaskbar = false,
+                StartPosition = FormStartPosition.Manual,
+                Location = new Point(-30000, -30000),
+                ClientSize = new Size(640, 480),
+                Opacity = 0
+            };
+            _host = new Panel { Dock = DockStyle.Fill };
+            _window.Controls.Add(_host);
+            _rdpSurface = new Panel { Dock = DockStyle.Fill, BackColor = Color.White };
+            _host.Controls.Add(_rdpSurface);
+            _cover = new RdpConnectingPanel(_host, "Connecting test");
+            _window.Show();
+        }
+
+        [TearDown]
+        public void TearDown()
+        {
+            _window.Dispose();
+        }
+
+        [Test]
+        public void Show_CoversTheSurfaceWithoutHidingOrDisablingIt()
+        {
+            _cover.ShowConnecting();
+
+            Assert.That(_cover.Visible, Is.True);
+            Assert.That(_host.Controls.GetChildIndex(_cover), Is.Zero);
+            Assert.That(_rdpSurface.Visible, Is.True);
+            Assert.That(_rdpSurface.Enabled, Is.True);
+            Assert.That(_cover.TabStop, Is.False);
+        }
+
+        [Test]
+        public void Dismiss_RevealsTheSurfaceWithoutDisposingIt()
+        {
+            _cover.ShowConnecting();
+            _cover.Dismiss();
+
+            Assert.That(_cover.Visible, Is.False);
+            Assert.That(_rdpSurface.Visible, Is.True);
+            Assert.That(_rdpSurface.IsDisposed, Is.False);
+        }
+
+        [Test]
+        public void ShowAfterDismiss_ReusesThePanelForAnotherConnectionAttempt()
+        {
+            _cover.ShowConnecting();
+            _cover.Dismiss();
+            _cover.ShowConnecting();
+
+            Assert.That(_cover.Visible, Is.True);
+            Assert.That(_host.Controls.Count, Is.EqualTo(2));
+        }
+
+        [Test]
+        public void HostResize_KeepsTheConnectingPanelFillingTheHost()
+        {
+            _cover.ShowConnecting();
+            _window.ClientSize = new Size(900, 600);
+            _host.PerformLayout();
+
+            Assert.That(_cover.Bounds, Is.EqualTo(_host.DisplayRectangle));
+        }
+
+        [Test]
+        public void ApplyColors_UpdatesThePanelAndLocalizedMessageWithoutShowingIt()
+        {
+            Color background = Color.FromArgb(30, 30, 46);
+            Color foreground = Color.FromArgb(205, 214, 244);
+            _cover.ApplyColors(background, foreground);
+            Label message = (Label)_cover.Controls[0];
+
+            Assert.That(_cover.Visible, Is.False);
+            Assert.That(_cover.BackColor, Is.EqualTo(background));
+            Assert.That(message.BackColor, Is.EqualTo(background));
+            Assert.That(message.ForeColor, Is.EqualTo(foreground));
+            Assert.That(message.Text, Is.EqualTo("Connecting test"));
+        }
+
+        [Test]
+        public void ApplyColors_AlsoAcceptsLightThemeColorsWhileVisible()
+        {
+            _cover.ShowConnecting();
+            _cover.ApplyColors(SystemColors.Control, SystemColors.ControlText);
+
+            Assert.That(_cover.Visible, Is.True);
+            Assert.That(_cover.BackColor, Is.EqualTo(SystemColors.Control));
+            Assert.That(_cover.ForeColor, Is.EqualTo(SystemColors.ControlText));
+        }
+
+        [Test]
+        public void WorkerThreadDismiss_IsMarshaledToTheUiThread()
+        {
+            _cover.ShowConnecting();
+            Exception failure = null;
+            Thread worker = new Thread(() =>
+            {
+                try { _cover.Dismiss(); }
+                catch (Exception ex) { failure = ex; }
+            });
+            worker.Start();
+            Assert.That(worker.Join(2000), Is.True);
+            Application.DoEvents();
+
+            Assert.That(failure, Is.Null);
+            Assert.That(_cover.Visible, Is.False);
+        }
+
+        [Test]
+        public void QueuedDismissAfterHostDisposal_DoesNotAccessDisposedControls()
+        {
+            _cover.ShowConnecting();
+            Thread worker = new Thread(() => _cover.Dismiss());
+            worker.Start();
+            Assert.That(worker.Join(2000), Is.True);
+            _host.Dispose();
+
+            Assert.DoesNotThrow(() => Application.DoEvents());
+            Assert.DoesNotThrow(() => _cover.ShowConnecting());
+            Assert.DoesNotThrow(() => _cover.Dismiss());
+        }
+
+        [Test]
+        public void DisposeOnUiThread_RemovesOnlyTheCover()
+        {
+            _cover.ShowConnecting();
+            _cover.DisposeOnUiThread();
+
+            Assert.That(_cover.IsDisposed, Is.True);
+            Assert.That(_rdpSurface.IsDisposed, Is.False);
+            Assert.That(_host.Controls.Count, Is.EqualTo(1));
+        }
+    }
+}
