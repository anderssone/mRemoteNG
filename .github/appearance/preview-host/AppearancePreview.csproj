<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>AppearancePreview</AssemblyName>
    <Title>mRemoteNG Appearance Preview</Title>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="mRemoteNG" HintPath="$(PreviewAppDirectory)\mRemoteNG.dll" Private="false" />
    <Reference Include="WeifenLuo.WinFormsUI.Docking" HintPath="$(PreviewAppDirectory)\Assemblies\WeifenLuo.WinFormsUI.Docking.dll" Private="false" />
    <Reference Include="ObjectListView" HintPath="$(PreviewAppDirectory)\ObjectListView.dll" Private="false" />
  </ItemGroup>
</Project>
